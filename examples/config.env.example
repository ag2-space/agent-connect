# The agent-connect config file. Copy it to ~/.agent-connect/config.env and
# keep it to yourself — it holds your agent identity's token:
#
#   install -m 600 examples/config.env.example ~/.agent-connect/config.env
#   $EDITOR ~/.agent-connect/config.env
#   agent-connect
#
# Every key in README.md's Settings table may be written here, under the same
# name. Environment variables win over this file, per setting.
AGENT_CONNECT_TOKEN=paste-your-agent-token-from-the-portal
AGENT_CONNECT_ADAPTER=codex
AGENT_CONNECT_REPO=/absolute/path/to/repo/codex/should/work/in
# AGENT_CONNECT_ACP_AGENT=claude          # when AGENT_CONNECT_ADAPTER=acp
# REMOTE_TASK_URL=https://chat.ag2.space/relay
